<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>PublishTool</Product>
    <StripSymbols Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">true</StripSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildVersion)' != ''">
    <Version>$(BuildVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2"/>
  </ItemGroup>

  <Target Name="GenBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
      <BuildVersion Condition="'$(BuildVersion)' == ''">dev</BuildVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="internal static class BuildInfo { public const string Version = &quot;$(BuildVersion)&quot;%3B }"/>
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)"/>
    </ItemGroup>
  </Target>

</Project>