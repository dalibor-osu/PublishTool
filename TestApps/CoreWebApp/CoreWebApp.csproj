<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppVersion Condition="'$(AppVersion)' == ''">1</AppVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AppVersion" Value="$(AppVersion)" />
    <Content Include="version.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
