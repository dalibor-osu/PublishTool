{{~ func option_label(option)
      ret (option.Aliases | array.join ", ") + (option.TakesValue ? " <" + option.ValueName + ">" : "")
    end ~}}
{{~ width = 0
    for option in Command.Options
      label = option_label option
      if label.size > width
        width = label.size
      end
    end ~}}
Usage: PublishTool {{ Command.Name }} [options]
{{~ if Command.Description ~}}

{{ Command.Description }}
{{~ end ~}}
{{~ if Command.IsDefault ~}}

This is the default command, it also runs when no command is given.
{{~ end ~}}

Options:
{{~ for option in Command.Options ~}}
{{~ label = option_label option ~}}
{{~ if option.Description ~}}
  {{ label | string.pad_right width }}  {{ option.Description }}
{{~ else ~}}
  {{ label }}
{{~ end ~}}
{{~ end ~}}
